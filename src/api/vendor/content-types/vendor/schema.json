{
  "kind": "collectionType",
  "collectionName": "vendors",
  "info": {
    "singularName": "vendor",
    "pluralName": "vendors",
    "displayName": "Vendor",
    "description": "Collection type for vendors in the RFQ platform"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "companyName": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "contactPerson": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "vatNumber": {
      "type": "string",
      "regex": "^3[0-9]{14}$",
      "description": "Saudi VAT Number (15 digits starting with 3)"
    },
    "commercialRegistration": {
      "type": "string",
      "regex": "^[0-9]{10}$",
      "description": "Commercial Registration (10 digits)"
    },
    "nationalAddress": {
      "type": "string",
      "regex": "^[0-9]{8}$",
      "description": "National Address (8 digits)"
    },
    "additionalNumbers": {
      "type": "json",
      "description": "Additional registration numbers (AVL, NWC, SE, MODON)"
    },
    "address": {
      "type": "text"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Saudi Arabia"
    },
    "website": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "specialties": {
      "type": "json",
      "description": "Vendor specialties and categories"
    },
    "isVerified": {
      "type": "boolean",
      "default": false
    },
    "rating": {
      "type": "decimal",
      "min": 0,
      "max": 5,
      "default": 0
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "bids": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bid.bid",
      "mappedBy": "vendor"
    }
  }
}